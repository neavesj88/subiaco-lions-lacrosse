# =============================================================================
# SUBIACO LIONS LACROSSE — Environment Configuration
# =============================================================================
# SETUP: Copy this file to .env and fill in your values.
#        The .env file is never committed to git (it's in .gitignore).
#        Run the app with: npm run dev
# =============================================================================

# ── App basics ───────────────────────────────────────────────────────────────
DATABASE_URL=./data/club.db          # SQLite file location — don't change this
SESSION_SECRET=change-this-to-a-long-random-string   # Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NODE_ENV=production                  # "production" for hosting, "development" for local dev
PORT=5000                            # Port the app listens on

# ── Cloudflare Tunnel (for Docker hosting — see SETUP_HOSTING.md) ────────────
# This token securely connects your site to the internet through Cloudflare,
# with automatic HTTPS and NO open ports / nginx / SSL certs needed.
# Get it from: Cloudflare Zero Trust dashboard → Networks → Tunnels → your tunnel.
# Leave blank if you're not using the Docker + Tunnel method.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Email notifications (Mailgun — same as neaves.au) ────────────────────────
# When configured, the club gets an email when:
#   - Someone submits the Contact form
#   - Someone submits the Sign Up / Expression of Interest form
#   - The registrant also gets a confirmation auto-reply
#
# SETUP (Mailgun — free tier handles a club's volume easily):
#   1. Sign up at mailgun.com
#   2. Add your domain (e.g. mail.subiacolions.com.au) and verify the DNS records
#   3. Go to SMTP settings — use European server: smtp.eu.mailgun.org port 587
#   4. Username = the full sending email (e.g. contact@mail.subiacolions.com.au)
#   5. Password = the SMTP password from the Mailgun dashboard
#
# If left blank: emails are skipped, form data still saves to the database.
# Admins can check Admin → Messages and Admin → Sign-Ups manually.
CONTACT_EMAIL_USER=contact@mail.yourdomain.com.au
CONTACT_EMAIL_PASS=your_mailgun_smtp_password
CLUB_NOTIFY_EMAIL=subiacolacrosseclub@outlook.com   # Where club notifications go

# ── Google OAuth (optional — enables "Sign in with Google" on admin login) ──
# SETUP:
#   1. Go to console.cloud.google.com
#   2. Create project → APIs & Services → Credentials
#   3. Create OAuth 2.0 Client ID → Web application
#   4. Add Authorised redirect URI: http://localhost:5000/api/auth/google/callback
#      (change localhost to your domain in production)
#   5. Copy Client ID and Secret below
#
# The Google email MUST match the email set in Admin → Users for that admin.
# If left blank: Google login button is hidden, username/password still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── Production only ──────────────────────────────────────────────────────────
# Change GOOGLE_CALLBACK_URL to your live domain when deploying:
# GOOGLE_CALLBACK_URL=https://yourdomain.com.au/api/auth/google/callback
