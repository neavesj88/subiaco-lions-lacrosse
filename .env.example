# =============================================================================
# CLUB WEBSITE — Environment Configuration
# =============================================================================
# SETUP: Copy this file to .env and fill in your values.
#        The .env file is never committed to git (it's in .gitignore).
#        Run the app with: npm run dev
# =============================================================================

# ── App basics ───────────────────────────────────────────────────────────────
DATABASE_URL=./data/club.db          # SQLite file location — don't change this

# REQUIRED for production: signs admin login cookies. If left as this
# placeholder, the server generates a random one on every start (secure, but
# all admins get logged out whenever the server restarts).
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=change-this-to-a-long-random-string

# How long an admin stays logged in with NO activity (sliding — any activity
# resets the clock, so someone actively working is never interrupted).
SESSION_IDLE_HOURS=2
NODE_ENV=production                  # "production" for hosting, "development" for local dev
PORT=5000                            # Port the app listens on

# The site's public address, e.g. https://yourclub.org.au (no slash at the
# end). Used for the links inside emails the site sends. Optional, but set it
# once you have a domain; the tunnel setup script fills it in for you.
SITE_URL=

# Which connections count as "our own proxy" (cloudflared or nginx), whose
# word is taken for the visitor's real address — that address is what the
# login lock-out counts against. Leave blank: it means this machine only,
# which is right for the clubhouse PC and a rented server. The Docker image
# sets its own value, because there cloudflared runs in a separate container.
TRUST_PROXY=

# ── Secret admin path ────────────────────────────────────────────────────────
# The admin login lives at this path instead of the easily-guessed "/admin".
# Pick something private and hard to guess (e.g. /lions-office-7y2x). The login
# page is then at <ADMIN_PATH>/login. This isn't a replacement for the password:
# it keeps the login out of the way of casual bots, but anyone reading the
# page's code can find it. The password and the lock-out after repeated wrong
# guesses are what keep people out.
# Keep this value private; it's only here on the server, never in the public repo.
ADMIN_PATH=/manage

# Starting password for the first "admin" account, created by `npm run db:seed`
# on a brand new install (one with no admin accounts at all). The clubhouse
# installer fills this in with a random one and prints it at the end. If it is
# blank when the seed runs, a random password is made up and printed instead.
# Change it after your first login — the admin panel nags until you do.
SEED_ADMIN_PASSWORD=

# ── Cloudflare Tunnel (for Docker hosting — see SETUP_HOSTING.md) ────────────
# This token securely connects your site to the internet through Cloudflare,
# with automatic HTTPS and NO open ports / nginx / SSL certs needed.
# Get it from: Cloudflare Zero Trust dashboard → Networks → Tunnels → your tunnel.
# Leave blank if you're not using the Docker + Tunnel method.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Email notifications (Mailgun — same as neaves.au) ────────────────────────
# When configured, the club gets an email when:
#   - Someone submits the Contact form
#   - Someone submits the Sign Up / Expression of Interest form
#   - The registrant also gets a confirmation auto-reply
#
# SETUP (Mailgun — free tier handles a club's volume easily):
#   1. Sign up at mailgun.com
#   2. Add your domain (e.g. mail.yourclub.org.au) and verify the DNS records
#   3. Go to SMTP settings — use European server: smtp.eu.mailgun.org port 587
#   4. Username = the full sending email (e.g. contact@mail.yourclub.org.au)
#   5. Password = the SMTP password from the Mailgun dashboard
#
# If left blank: emails are skipped, form data still saves to the database.
# Admins can check Admin → Messages and Admin → Sign-Ups manually.
# (Example: CONTACT_EMAIL_USER=contact@mail.yourclub.org.au)
# Most clubs set these in Admin -> Settings -> Email instead, which wins over
# anything here.
CONTACT_EMAIL_USER=
CONTACT_EMAIL_PASS=
# Where enquiries and order notifications are emailed. LEAVE THIS BLANK unless
# you want them going somewhere other than the club contact address you set in
# Admin -> Settings. Never leave another club's address here.
CLUB_NOTIFY_EMAIL=

# ── Google OAuth (optional — enables "Sign in with Google" on admin login) ──
# SETUP:
#   1. Go to console.cloud.google.com
#   2. Create project → APIs & Services → Credentials
#   3. Create OAuth 2.0 Client ID → Web application
#   4. Add Authorised redirect URI: http://localhost:5000/api/auth/google/callback
#      (change localhost to your domain in production)
#   5. Copy Client ID and Secret below
#
# The Google email MUST match the email set in Admin → Users for that admin.
# If left blank: Google login button is hidden, username/password still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── Production only ──────────────────────────────────────────────────────────
# Change GOOGLE_CALLBACK_URL to your live domain when deploying:
# GOOGLE_CALLBACK_URL=https://yourdomain.com.au/api/auth/google/callback

# ── Backups (optional) ───────────────────────────────────────────────────────
# Where nightly backups go, and how many to keep. Default: data/backups, 30.
# Pointing BACKUP_DIR at a USB stick or network drive means a dead disk
# doesn't take the backups with it. backup.sh and restore.sh both read these.
# BACKUP_DIR=/media/usb/club-backups
# BACKUP_KEEP=30
